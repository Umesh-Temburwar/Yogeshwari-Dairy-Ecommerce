# ==============================================================================
# Yogeshwari Dairy E-Commerce — Environment Configuration Template (.env.example)
#
# Vite exposes variables prefixed with VITE_ to client-side code via import.meta.env
# NOTE: Never store database passwords, service-role keys, or private backend
# secrets in this frontend environment file.
# ==============================================================================

# E-Commerce Mode (false = live backend connection, true = local mock)
VITE_USE_MOCK_API=false

# Render Express Backend Endpoints
VITE_BACKEND_URL=https://yogeshwari-dairy-shop-inventory-system.onrender.com/api/v1/ecommerce
VITE_API_BASE_URL=https://yogeshwari-dairy-shop-inventory-system.onrender.com/api/v1

# Supabase Production Configuration (Client-side Anon Key only)
VITE_SUPABASE_URL=https://pfamoxreojbejufwhgiu.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Store Information & WhatsApp Hotline
VITE_STORE_NAME=Yogeshwari Dairy Products
VITE_STORE_PHONE=+919370869896

# Quick-Commerce Delivery Rules
VITE_FREE_DELIVERY_THRESHOLD=300
VITE_STANDARD_DELIVERY_FEE=30
